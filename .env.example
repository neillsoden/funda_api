GOOGLE_PLACES_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Build with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
# then base64-encode "neill:<hash>,yvonne:<hash>" (Docker Compose's env_file loader
# treats literal "$" in values as shell interpolation and mangles raw hashes):
#   python -c "import base64; print(base64.b64encode(b'neill:<hash>,yvonne:<hash>').decode())"
AUTH_USERS_B64=
# Set to 1 only in production behind HTTPS - forces the session cookie to require TLS.
FORCE_HTTPS_COOKIES=0
